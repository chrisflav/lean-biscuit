import LeanBiscuit.Token.Biscuit
import LeanBiscuit.Parser

/-!
# Creating and attenuating tokens

The other half of the specification: minting a token, adding a block to one, and
sealing it.

Attenuation is the point of the format.  A token carries the secret matching the
public key its last block names, so whoever holds it can sign one more block —
and only append, since every block's signature covers the previous one.  That
ephemeral key pair is meant to be forgotten as soon as it has been used.

Every operation that signs comes in two forms.  The plain one takes a
`PrivateKey` and signs with the curve arithmetic in this library, whose running
time depends on the secret.  The `…With` form takes the public key and a
signing function instead, so that a long-lived key — a token issuer's root key,
a third party's key — can stay behind a signer with a constant-time guarantee,
such as a hardware module or OpenSSL.  Both forms share one implementation
(`createSigned`, `appendSigned`, `thirdPartyPayload`), so they produce the same
bytes for the same key; the plain forms are exactly what they were before the
`…With` forms existed, deriving no public key they did not derive then.  The
`…With` forms verify every signature the external signer returns under the
key it was declared for, so a wrong signer is an error rather than a token that
does not verify.  The ephemeral next keys are always generated by the caller
and handled in Lean: they sign one block each and travel inside the token.
-/

namespace LeanBiscuit
namespace Token

open Datalog Proto

/-- The contents of a block, before it is interned and signed. -/
structure BlockBuilder where
  /-- Facts the block states. -/
  facts : List Builder.Fact := []
  /-- Rules the block defines. -/
  rules : List Builder.Rule := []
  /-- Checks the block imposes. -/
  checks : List Builder.Check := []
  /-- The block-level trust annotation. -/
  scopes : List Builder.Scope := []
  /-- Free-form context. -/
  context : Option String := none
  deriving Inhabited

namespace BlockBuilder

/-- Add the contents of a datalog source string. -/
def code (b : BlockBuilder) (source : String) : Except TokenError BlockBuilder :=
  match Parser.parseBlock source with
  | .error e => throw (.language e)
  | .ok r =>
    pure { b with
      facts := b.facts ++ r.facts,
      rules := b.rules ++ r.rules,
      checks := b.checks ++ r.checks,
      scopes := b.scopes ++ r.scopes }

/-- Intern the block's contents on top of `baseSymbols`.

The block's own symbol table is what interning *added*: everything the base
table already had is referred to by index and does not travel with the block. -/
def build (b : BlockBuilder) (baseSymbols : SymbolTable) : Block :=
  let symbolStart := baseSymbols.symbols.size
  let keyStart := baseSymbols.publicKeys.size
  let (facts, symbols) := b.facts.foldl (fun (acc, t) f =>
    let (f, t) := Builder.Fact.convert t f; (acc ++ [f], t)) (([] : List Fact), baseSymbols)
  let (rules, symbols) := b.rules.foldl (fun (acc, t) r =>
    let (r, t) := Builder.Rule.convert t r; (acc ++ [r], t)) (([] : List Rule), symbols)
  let (checks, symbols) := b.checks.foldl (fun (acc, t) c =>
    let (c, t) := Builder.Check.convert t c; (acc ++ [c], t)) (([] : List Check), symbols)
  let (scopes, symbols) := b.scopes.foldl (fun (acc, t) s =>
    let (s, t) := Builder.Scope.convert t s; (acc ++ [s], t)) (([] : List Datalog.Scope), symbols)
  let newSymbols := symbols.symbols.extract symbolStart symbols.symbols.size
  let newKeys := symbols.publicKeys.extract keyStart symbols.publicKeys.size
  { symbols := { symbols := newSymbols, publicKeys := newKeys },
    facts, rules, checks,
    context := b.context,
    version := (getSchemaVersion facts rules checks scopes).version,
    externalKey := none,
    publicKeys := newKeys,
    scopes }

end BlockBuilder

/-- Which signature payload format a new block must use.

Version 1 is required whenever the block could otherwise be replayed or
misread: third-party blocks, blocks using datalog v3.3, and blocks signed with
anything other than Ed25519.  Otherwise a token keeps the format its existing
blocks already use. -/
def blockSignatureVersion (signingAlgorithm nextAlgorithm : Algorithm)
    (hasExternalSignature : Bool) (blockVersion : Option Nat)
    (previousVersions : List Nat) : Nat :=
  if hasExternalSignature then thirdPartySignatureVersion
  else if (blockVersion.getD 0) ≥ datalog33 then 1
  else if signingAlgorithm != .ed25519 || nextAlgorithm != .ed25519 then 1
  else previousVersions.foldl Nat.max 0

namespace Biscuit

/-- Rebuild the decoded view of a container after its blocks changed. -/
def ofContainer (container : Proto.Biscuit) : Except TokenError Biscuit := do
  let blocks ← liftM (((signedBlocks container).mapM fun b =>
    decodeBlock b.block (b.externalSignature.map (·.publicKey))).mapError TokenError.format)
  let symbols ← liftM (buildSymbols blocks |>.mapError TokenError.format)
  pure { container, rootKeyId := container.rootKeyId, symbols, blocks }

/-- Signing in Lean with a private key, the signer the functions that take a
`PrivateKey` use.  Its failures are those of `PrivateKey.sign`. -/
def signIn [Monad m] (k : PrivateKey) (payload : Bytes) : ExceptT TokenError m Bytes :=
  liftExcept ((k.sign payload).mapError TokenError.format)

/-- An external signer checked against the key it claims to sign for: each
signature it returns is verified with `PublicKey.verifySignature` over the
payload it was given, and one that does not verify — the wrong length, not
DER for secp256r1, made with another key, or garbage — is refused with that
verification's error before any token is built from it. -/
def checkedSigner [Monad m] (publicKey : PublicKey) (sign : Bytes → m Bytes)
    (payload : Bytes) : ExceptT TokenError m Bytes := do
  let signature ← (sign payload : m Bytes)
  liftExcept ((publicKey.verifySignature payload signature).mapError TokenError.format)
  pure signature

/-- Mint a token whose authority block is signed by `sign`, for a root key of
`rootAlgorithm`.  Nothing here checks the signature; `create` and
`createWith` decide whether it is checked. -/
def createSigned [Monad m] (rootAlgorithm : Algorithm) (sign : Bytes → ExceptT TokenError m Bytes)
    (nextKey : PrivateKey) (authority : BlockBuilder) (rootKeyId : Option Nat) :
    ExceptT TokenError m Biscuit := do
  let block := authority.build {}
  let data := encodeBlock block
  let nextPublic ← liftExcept ((nextKey.publicKey).mapError TokenError.format)
  let version := blockSignatureVersion rootAlgorithm nextKey.algorithm false
    (some block.version) []
  let payload :=
    if version == 0 then blockSignaturePayloadV0 data nextPublic none
    else authorityBlockSignaturePayloadV1 data nextPublic version
  let signature ← sign payload
  liftExcept <| ofContainer
    { rootKeyId,
      authority := { block := data, nextKey := nextPublic, signature, version },
      blocks := [],
      proof := .secret nextKey.key }

/-- Mint a token whose authority block is signed by `signRoot`, a signer for
the root key `rootPublic` that the library does not hold.

This is the form to use when the root key is long-lived: the curve arithmetic
here runs in time that depends on the secret, which is fine for verifying and
for the single-use keys below, but not for a key that signs many tokens.
`signRoot` is given the exact payload and must return its signature in the
format the algorithm uses in tokens — 64 bytes for Ed25519, DER for
secp256r1.  The signature is verified under `rootPublic` before the token is
built (`checkedSigner`), so a misconfigured signer gives an error, never a
token that `ofBytes` would refuse.  ECDSA signatures with a high `s`, which
OpenSSL may produce, are accepted: the verifier here does not require low-S.

`nextKey` is the ephemeral key pair whose secret travels with the token so that
it can be attenuated; it should be generated at random and then forgotten. -/
def createWith [Monad m] (rootPublic : PublicKey) (signRoot : Bytes → m Bytes)
    (nextKey : PrivateKey) (authority : BlockBuilder) (rootKeyId : Option Nat := none) :
    ExceptT TokenError m Biscuit :=
  createSigned rootPublic.algorithm (checkedSigner rootPublic signRoot) nextKey authority
    rootKeyId

/-- Mint a token, signing its authority block in Lean with `root`.

`nextKey` is the ephemeral key pair whose secret travels with the token so that
it can be attenuated; it should be generated at random and then forgotten. -/
def create (root : PrivateKey) (nextKey : PrivateKey) (authority : BlockBuilder)
    (rootKeyId : Option Nat := none) : Except TokenError Biscuit :=
  (createSigned (m := Id) root.algorithm (signIn root) nextKey authority rootKeyId).run

/-- The secret the token carries, which is what allows appending one more
block. -/
def proofKey (b : Biscuit) : Except TokenError PrivateKey := do
  match b.container.proof with
  | .seal _ => throw .appendOnSealed
  | .secret secret =>
    let lastKey := (signedBlocks b.container).getLast!.nextKey
    liftM ((PrivateKey.ofBytes lastKey.algorithm secret).mapError TokenError.format)

/-- The last signature of the chain, which the next block's signature covers. -/
def lastSignature (b : Biscuit) : Bytes := (signedBlocks b.container).getLast!.signature

/-- Append an already serialized block, optionally carrying a third party's
signature, signing it with `sign` as a key of `signingAlgorithm`.  Nothing here
checks the signature. -/
def appendSigned [Monad m] (b : Biscuit) (signingAlgorithm : Algorithm)
    (sign : Bytes → ExceptT TokenError m Bytes) (nextKey : PrivateKey) (data : Bytes)
    (externalSignature : Option ExternalSignature) (blockVersion : Option Nat) :
    ExceptT TokenError m Biscuit := do
  let nextPublic ← liftExcept ((nextKey.publicKey).mapError TokenError.format)
  let previousVersions := (signedBlocks b.container).map (·.version)
  let version := blockSignatureVersion signingAlgorithm nextKey.algorithm
    externalSignature.isSome blockVersion previousVersions
  let payload :=
    if version == 0 then blockSignaturePayloadV0 data nextPublic externalSignature
    else blockSignaturePayloadV1 data nextPublic externalSignature b.lastSignature version
  let signature ← sign payload
  liftExcept <| ofContainer { b.container with
    blocks := b.container.blocks ++
      [{ block := data, nextKey := nextPublic, signature, externalSignature, version }],
    proof := .secret nextKey.key }

/-- Append an already serialized block, optionally carrying a third party's
signature, signing it with `sign`, a signer for `signingPublic`.  A sealed
token, or a declared key that is not the one the token's last block names, is
refused before `sign` is called; the signature `sign` returns is then verified
under the declared key (`checkedSigner`), so a signer that actually holds
another key is refused after signing. -/
def appendSerializedWith [Monad m] (b : Biscuit) (signingPublic : PublicKey)
    (sign : Bytes → m Bytes) (nextKey : PrivateKey) (data : Bytes)
    (externalSignature : Option ExternalSignature) (blockVersion : Option Nat) :
    ExceptT TokenError m Biscuit := do
  if b.isSealed then throw .appendOnSealed
  if signingPublic != (signedBlocks b.container).getLast!.nextKey then
    throw (.format (.signature (.invalidSignatureGeneration
      "the signing key is not the key the token's last block names")))
  b.appendSigned signingPublic.algorithm (checkedSigner signingPublic sign) nextKey data
    externalSignature blockVersion

/-- Append an already serialized block, optionally carrying a third party's
signature, signing it in Lean with the secret the token carries. -/
def appendSerialized (b : Biscuit) (nextKey : PrivateKey) (data : Bytes)
    (externalSignature : Option ExternalSignature) (blockVersion : Option Nat) :
    Except TokenError Biscuit := do
  let signingKey ← b.proofKey
  (b.appendSigned (m := Id) signingKey.algorithm (signIn signingKey) nextKey data
    externalSignature blockVersion).run

/-- Attenuate the token by appending a block, signed by `sign`, a signer for
`signingPublic` — the key the token's last block names, whose secret is in the
token (`proofKey`).  This is the same operation as `append` with the signing
step supplied by the caller, as `appendSerializedWith` checks it.

The new block can only restrict what the token allows: its checks are added to
those already there, and its rules can only see the facts its scope trusts. -/
def appendWith [Monad m] (b : Biscuit) (signingPublic : PublicKey) (sign : Bytes → m Bytes)
    (nextKey : PrivateKey) (blockBuilder : BlockBuilder) : ExceptT TokenError m Biscuit := do
  let block := blockBuilder.build b.symbols
  if !b.symbols.isDisjoint block.symbols then
    throw (.format .symbolTableOverlap)
  b.appendSerializedWith signingPublic sign nextKey (encodeBlock block) none (some block.version)

/-- Attenuate the token by appending a block, signed in Lean.

The new block can only restrict what the token allows: its checks are added to
those already there, and its rules can only see the facts its scope trusts. -/
def append (b : Biscuit) (nextKey : PrivateKey) (blockBuilder : BlockBuilder) :
    Except TokenError Biscuit := do
  let block := blockBuilder.build b.symbols
  if !b.symbols.isDisjoint block.symbols then
    throw (.format .symbolTableOverlap)
  b.appendSerialized nextKey (encodeBlock block) none (some block.version)

/-- Seal the token, so that no further block can be appended.

The proof stops being a usable secret and becomes a signature over the last
block, which nobody can extend. -/
def sealToken (b : Biscuit) : Except TokenError Biscuit := do
  let signingKey ← b.proofKey
  let last := (signedBlocks b.container).getLast!
  let signature ← liftM ((signingKey.sign (sealSignaturePayloadV0 last)).mapError
    TokenError.format)
  pure { b with container := { b.container with proof := .seal signature } }

/-! ## Third-party blocks

A third party can vouch for a block without ever seeing the token.  It is given
only the previous signature, which is enough to bind its block to that one token
and nothing else. -/

/-- The context a third party needs in order to sign a block for this token. -/
def thirdPartyRequest (b : Biscuit) : ThirdPartyBlockRequest := ⟨b.lastSignature⟩

/-- The serialized block a third party signs for a request, and the payload its
signature covers.  Third-party blocks start from the default symbol table,
since the signer does not have the token's. -/
def thirdPartyPayload (request : ThirdPartyBlockRequest) (blockBuilder : BlockBuilder) :
    Bytes × Bytes :=
  let block := blockBuilder.build {}
  let block := { block with version := Nat.max datalog32 block.version }
  let payload := encodeBlock block
  (payload, externalSignaturePayloadV1 payload request.previousSignature
    thirdPartySignatureVersion)

/-- Sign a block as a third party, in response to a request, with `sign`, a
signer for `publicKey` that the library does not hold.  A third party's key is
long-lived, so this is the form for one that must not meet the curve arithmetic
here; `sign` returns the signature in the format of `createWith`, and it is
verified under `publicKey` before the contents are returned (`checkedSigner`). -/
def signThirdPartyBlockWith [Monad m] (publicKey : PublicKey) (sign : Bytes → m Bytes)
    (request : ThirdPartyBlockRequest) (blockBuilder : BlockBuilder) :
    ExceptT TokenError m ThirdPartyBlockContents := do
  let (payload, signed) := thirdPartyPayload request blockBuilder
  let signature ← checkedSigner publicKey sign signed
  pure ⟨payload, ⟨signature, publicKey⟩⟩

/-- Sign a block as a third party, in response to a request, in Lean.

Third-party blocks start from the default symbol table, since the signer does
not have the token's. -/
def signThirdPartyBlock (key : PrivateKey) (request : ThirdPartyBlockRequest)
    (blockBuilder : BlockBuilder) : Except TokenError ThirdPartyBlockContents := do
  let (payload, signed) := thirdPartyPayload request blockBuilder
  let signature ← liftM ((key.sign signed).mapError TokenError.format)
  let publicKey ← liftM ((key.publicKey).mapError TokenError.format)
  pure ⟨payload, ⟨signature, publicKey⟩⟩

/-- Append a block a third party signed, signing the chain with `sign`, a
signer for `signingPublic`, checked as `appendSerializedWith` checks it. -/
def appendThirdPartyWith [Monad m] (b : Biscuit) (signingPublic : PublicKey)
    (sign : Bytes → m Bytes) (nextKey : PrivateKey) (contents : ThirdPartyBlockContents) :
    ExceptT TokenError m Biscuit :=
  b.appendSerializedWith signingPublic sign nextKey contents.payload
    (some contents.externalSignature) none

/-- Append a block a third party signed. -/
def appendThirdParty (b : Biscuit) (nextKey : PrivateKey)
    (contents : ThirdPartyBlockContents) : Except TokenError Biscuit :=
  b.appendSerialized nextKey contents.payload (some contents.externalSignature) none

end Biscuit

end Token
end LeanBiscuit
